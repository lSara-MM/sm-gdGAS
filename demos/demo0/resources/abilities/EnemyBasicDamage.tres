script/source = "extends GameplayAbility
class_name BasicDamageAbility

## Default: On activate ability, effects are applied to self or if overriden, to the return value of _calculate_targets(), automatically and then the ability ends instantly. To override, uncomment and call commit_ability(), apply_effects_to_target() and try_end(bool cancelled) manually.
## Warning: This method shouldn't be called manually as it gets called automatically by the ability_container::try_active() method.
#func _activate_ability():
	#pass

## Warning: This method shouldn't be called manually as it gets called automatically by the ability_container::try_end(bool cancelled) method.
#func _end_ability(_was_cancelled: bool):
	#pass

#func _check_availability() -> bool:
	#return true

func _calculate_targets() -> Array[GAS_Entity]:
	return get_entity_owner().targets
"

