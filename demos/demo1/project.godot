;   param=value ; assign values to parameters

config_version=5

[GDExtAbilities]

tag_registry_path="res://gen/tags/tag_registry.tres"

[application]

config/name="NoGDExt_Showcase"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/image="res://assets/GDExtAbilityIcon.png"
config/icon="res://assets/GDExtAbilityIcon.png"
boot_splash/minimum_display_time=1

[display]

mouse_cursor/custom_image="res://assets/crosshair.png"
mouse_cursor/tooltip_position_offset=Vector2(0, 0)

[global_group]

Player=""
Enemy=""

