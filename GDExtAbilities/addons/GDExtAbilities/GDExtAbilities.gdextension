[configuration]

entry_symbol = "gdextabilities_plugin_entry"
compatibility_minimum = "4.3"
reloadable = true
doc_classes = "doc_classes"

[libraries]

windows.debug.x86_64 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.windows.template_release.x86_32.dll"

linux.debug.x86_64 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/GDExtAbilities/bin/libGDExtAbilities.linux.template_release.x86_64.so"

macos.debug = "res://addons/GDExtAbilities/bin/libGDExtAbilities.macos.template_debug.framework"
macos.release = "res://addons/GDExtAbilities/bin/libGDExtAbilities.macos.template_release.framework"